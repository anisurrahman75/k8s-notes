# project_id — export TF_VAR_project_id="my-gcp-project" or set it here
project_id  = "my-gcp-project"
region      = "us-central1"
name_prefix = "kubestash-gke"

# Network
subnet_cidr   = "10.10.0.0/20"
pods_cidr     = "10.20.0.0/16"
services_cidr = "10.30.0.0/20"

# GKE
cluster_name       = "kubestash-vs"
node_locations     = ["us-central1-a"]
kubernetes_version = ""          # empty = release channel default
release_channel    = "REGULAR"
node_machine_type  = "e2-standard-4"
node_count         = 1           # per zone
node_disk_type     = "pd-ssd"
node_disk_size_gb  = 100
